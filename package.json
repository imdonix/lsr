{
  "name": "los-santos-rising",
  "version": "1.0.0",
  "description": "Browser open-world crime game inspired by GTA San Andreas. three.js, fully procedural.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js 8080",
    "build": "node tools/write_version.js",
    "map": "python3 tools/make_map.py",
    "test:story": "node tools/bot.js --from m01 --to m24",
    "agent:loop": "node tools/agent/loop.mjs",
    "agent:once": "node tools/agent/loop.mjs --once",
    "agent:dry": "node tools/agent/loop.mjs --dry-run",
    "agent:swarm": "node tools/agent/swarm.mjs",
    "agent:swarm:once": "node tools/agent/swarm.mjs --once",
    "agent:swarm:dry": "node tools/agent/swarm.mjs --dry-run",
    "agent:gates": "node tools/agent/gates.mjs",
    "agent:status": "node tools/agent/status.mjs",
    "agent:stop": "touch .agent/STOP"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "puppeteer-core": "^25.12.0",
    "three": "^0.186.1"
  }
}
